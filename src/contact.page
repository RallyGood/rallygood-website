---
title: Contact
description: Contact RallyGood – questions, launch updates, partnership and sponsorship enquiries, or to raise a concern.
---
    <section class="page-hero section-soft">
      <div class="shell">
        <p class="eyebrow">Contact</p>
        <h1>Say hello.</h1>
        <p class="lead-small">Email us at <a class="text-link" href="mailto:{{EMAIL}}">{{EMAIL}}</a> or use the form below.</p>
      </div>
    </section>

    <section class="section">
      <div class="shell prose-grid">
        <form class="contact-form" id="contact-form" novalidate>
          <div class="field">
            <label for="cf-name">Your name</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required>
            <p class="field-error" id="cf-name-err" hidden>Please enter your name.</p>
          </div>
          <div class="field">
            <label for="cf-email">Your email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required>
            <p class="field-error" id="cf-email-err" hidden>Please enter a valid email address.</p>
          </div>
          <div class="field">
            <label for="cf-topic">What is this about?</label>
            <select id="cf-topic" name="topic">
              <option value="general">General question</option>
              <option value="updates">Launch updates</option>
              <option value="team">Starting a Rally Team</option>
              <option value="sponsor">Business sponsorship</option>
              <option value="partner">Delivery partner enquiry</option>
              <option value="concern">Raise a concern</option>
            </select>
          </div>
          <div class="field">
            <label for="cf-message">Message</label>
            <textarea id="cf-message" name="message" rows="6" required></textarea>
            <p class="field-error" id="cf-message-err" hidden>Please write a message.</p>
          </div>
          <div class="field check-field">
            <input id="cf-consent" name="consent" type="checkbox" required>
            <label for="cf-consent">I understand RallyGood will use my details only to reply to this message. See the <a class="text-link" href="privacy.html">privacy notice</a>.</label>
            <p class="field-error" id="cf-consent-err" hidden>Please tick to confirm.</p>
          </div>
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp">
          <button class="button button-primary" type="submit">{{FORM_BUTTON}}</button>
          <p class="small-print" id="cf-status" role="status">{{FORM_STATUS}} <a class="text-link" href="mailto:{{EMAIL}}">{{EMAIL}}</a>.</p>
        </form>
        <aside class="prose-aside">
          <div class="dignity-card">
            <strong>Raising a concern</strong>
            <p>If you have a concern about RallyGood, a partner or a safeguarding matter, choose “Raise a concern” or email <a href="mailto:{{EMAIL}}?subject=Raise%20a%20concern">{{EMAIL}}</a>. We will take it seriously.</p>
          </div>
        </aside>
      </div>
    </section>
